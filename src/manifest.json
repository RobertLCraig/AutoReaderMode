{
  "manifest_version": 3,
  "name": "Auto Reader Mode",
  "version": "2.0",
  "description": "Automatically opens reader mode on sites you choose, on known paywall sites, and on pages flagged by paywall / ad heuristics. Edge uses Immersive Reader; Chrome uses an inline overlay powered by Mozilla Readability.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "webNavigation",
    "activeTab"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["data/paywalls.json", "data/ad-heavy.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
